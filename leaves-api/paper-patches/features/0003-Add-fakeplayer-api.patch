diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index d083e3e5f00aac3e5c48a248cae665f3517a4b4a..fd43ae39a7db49f06b412adcc525afa86da9ffab 100644
